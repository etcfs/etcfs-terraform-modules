#!/bin/bash
# EtcFS ASG node bootstrap. Runs once on first boot of every instance the
# ASG launches — scale-out is "the ASG starts an instance", nothing external
# SSHes in. Mirrors scripts/infra/add-compute-node.sh's join logic, but
# self-executed from released packages instead of operator-driven and
# built from source, since a launch template has no SSH access back to a
# dev machine.
#
# Peer discovery is EC2 tag search, not a fixed IP list: any instance
# tagged ClusterName=<cluster>,Role=etcfs-node and running is a candidate
# seed. Empty result means "I am the first node" and this instance forms a
# new etcd cluster instead of joining one.
set -euo pipefail
exec > >(tee /var/log/etcfs-bootstrap.log) 2>&1

CLUSTER="${cluster_name}"
REGION="${region}"
VOLUME_ID="${volume_id}"
ETCFS_VERSION="${etcfs_version}"
ETCD_VERSION="${etcd_version}"
LEASE_TTL="${lease_ttl}"
GITHUB_REPO="${github_repo}"

log() { echo "[$(date -u +%H:%M:%S)] $*"; }

# ---- IMDSv2 ----
TOKEN=$(curl -sX PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
imds() { curl -sH "X-aws-ec2-metadata-token: $TOKEN" "http://169.254.169.254/latest/meta-data/$1"; }
INSTANCE_ID=$(imds instance-id)
PRIV_IP=$(imds local-ipv4)
NODE_ID="$${CLUSTER}-$(echo -n "$INSTANCE_ID" | tail -c 8)"

log "instance=$INSTANCE_ID private_ip=$PRIV_IP node_id=$NODE_ID"

# ---- Packages ----
dnf install -y fuse3-libs jq >/dev/null

if [[ -z "$ETCFS_VERSION" ]]; then
  ETCFS_VERSION=$(curl -fsSL "https://api.github.com/repos/$GITHUB_REPO/releases/latest" | jq -r .tag_name | tr -d v)
fi
log "installing EtcFS $ETCFS_VERSION, etcd $ETCD_VERSION"

curl -fsSL "https://github.com/etcd-io/etcd/releases/download/$${ETCD_VERSION}/etcd-$${ETCD_VERSION}-linux-amd64.tar.gz" -o /tmp/etcd.tar.gz
tar -xzf /tmp/etcd.tar.gz -C /usr/local/bin --strip-components=1 \
  "etcd-$${ETCD_VERSION}-linux-amd64/etcd" "etcd-$${ETCD_VERSION}-linux-amd64/etcdctl"
chmod +x /usr/local/bin/etcd /usr/local/bin/etcdctl

cd /tmp
for pkg in etcfuse-meta etcfsctl; do
  curl -fsSLO "https://github.com/$GITHUB_REPO/releases/download/v$${ETCFS_VERSION}/$${pkg}-$${ETCFS_VERSION}-1.x86_64.rpm"
  dnf install -y "./$${pkg}-$${ETCFS_VERSION}-1.x86_64.rpm"
done

# ponytail: releases up through v0.35.0 shipped an etcfuse RPM built
# against a newer glibc than any AL2023 AMI has (GLIBC_2.38 required,
# AL2023 tops out at 2.34) — a CI runner/target mismatch, not an
# ASG-specific problem. etcfuse-meta/etcfsctl are Go, CGO_ENABLED=0,
# unaffected; only the C daemon needs this. Build it from source instead of
# installing the broken release asset, same compiler invocation
# add-compute-node.sh uses. Fixed in CI (.github/workflows/ci.yml now
# builds etcfuse inside amazonlinux:2023) — revert to installing the RPM
# once a release cut *after* that fix exists; every release up to and
# including v0.35.0 still needs this workaround.
dnf install -y gcc fuse3-devel >/dev/null
curl -fsSL "https://github.com/$GITHUB_REPO/archive/refs/tags/v$${ETCFS_VERSION}.tar.gz" -o /tmp/etcfs-src.tar.gz
mkdir -p /tmp/etcfs-src && tar -xzf /tmp/etcfs-src.tar.gz -C /tmp/etcfs-src --strip-components=1
cd /tmp/etcfs-src
gcc -I. -Wall -Wextra -Werror -std=c11 -D_GNU_SOURCE -O2 -g \
    cmd/etcfuse/main.c pkg/fuse/fuse.c pkg/fuse/ops.c pkg/block/block.c \
    -o /usr/local/bin/etcfuse -lfuse3 -lpthread
chmod +x /usr/local/bin/etcfuse
cd /tmp

# The WAL goes in its own directory so its fsyncs — one per Raft commit, and
# every create, lock acquisition and extent publication is a Raft commit — do
# not queue behind snapshot and compaction I/O in the data directory. On the
# root volume this separates the two workloads but not the device; mount
# /var/lib/etcd-wal on an instance store or a second EBS volume to separate
# those too.
ETCD_WAL_DIR=/var/lib/etcd-wal
mkdir -p /mnt/etcfuse /run/etcfuse /var/lib/etcd "$ETCD_WAL_DIR"

# ---- Attach the shared Multi-Attach volume to myself ----
log "attaching volume $VOLUME_ID"
aws ec2 attach-volume --region "$REGION" --volume-id "$VOLUME_ID" \
  --instance-id "$INSTANCE_ID" --device /dev/sdf || log "attach-volume: already attached or racing another node, continuing"
for _ in $(seq 1 15); do
  [[ -e /dev/nvme1n1 || -e /dev/xvdf ]] && break
  sleep 2
done
DEVICE=/dev/nvme1n1
[[ -e "$DEVICE" ]] || DEVICE=/dev/xvdf

# ---- Elect the cluster-forming seed via DynamoDB conditional writes ----
# EC2 instance state is not a readiness signal: instances the ASG launches
# together all show "running" the moment their VM boots, well before any of
# them has etcd listening. A plain tag-search for "running peers" (the
# first version of this script) picks a peer with nothing on 2379 yet, and
# every concurrently-launched node makes the same mistake at once.
#
# A first version of this used SSM Parameter Store instead — put-parameter
# without --overwrite is an atomic create, one winner becomes the seed. But
# SSM has no compare-and-swap for the reclaim path (a dead/stale seed), only
# an unconditional --overwrite: running the actual 3-node race twice showed
# this forks the cluster two different ways — either multiple nodes reclaim
# simultaneously and each forms its own single-node cluster, or a slower
# (but still alive) seed gets its claim stolen out from under it by a joiner
# whose own timeout fired first. DynamoDB's conditional PutItem is true
# CAS — a reclaim is conditioned on the exact previously-read item, so
# concurrent reclaimers converge on exactly one winner, and staleness is
# judged against a shared "created_at" timestamp rather than each caller's
# own arbitrarily-timed health-check loop.
TABLE="${seed_table}"
STALE_SECONDS=600

put_if_absent() {
  aws dynamodb put-item --region "$REGION" --table-name "$TABLE" \
    --item "{\"cluster_name\":{\"S\":\"$CLUSTER\"},\"seed_ip\":{\"S\":\"$PRIV_IP\"},\"created_at\":{\"N\":\"$(date +%s)\"}}" \
    --condition-expression "attribute_not_exists(cluster_name)" 2>/dev/null
}

# Point the seed row at $1, but only if it still holds exactly the item that
# was read ($2/$3).  Used both to reclaim a dead seed's row for this node and
# to repoint it at a surviving peer; either way the CAS is what keeps
# concurrent writers converging on one winner.
repoint_if_unchanged() {
  local new_ip="$1" old_ip="$2" old_created="$3"
  aws dynamodb put-item --region "$REGION" --table-name "$TABLE" \
    --item "{\"cluster_name\":{\"S\":\"$CLUSTER\"},\"seed_ip\":{\"S\":\"$new_ip\"},\"created_at\":{\"N\":\"$(date +%s)\"}}" \
    --condition-expression "seed_ip = :oip AND created_at = :ocr" \
    --expression-attribute-values "{\":oip\":{\"S\":\"$old_ip\"},\":ocr\":{\"N\":\"$old_created\"}}" 2>/dev/null
}

# Tag-discover every other node in the cluster and ask its etcd directly
# whether it is serving.  The seed row is a bootstrap *hint*, not a liveness
# oracle: it is written once, at cluster formation, and nothing ever
# refreshes it — not the seed itself, not the graceful-leave Lambda.  So a
# long-lived cluster whose original seed has since been scaled in or replaced
# still carries a row naming a dead IP with a "created_at" months past the
# staleness bar, and a node joining then would sail through the age check and
# reclaim on the first attempt.  That forms a second, single-node etcd
# cluster beside a perfectly healthy quorum — two clusters, one shared block
# device, which is precisely the split brain everything else here exists to
# prevent.  The staleness bar only ever protected the concurrent-boot window
# it was written for; it says nothing about steady-state seed replacement.
# Asking the survivors does, and it is the same tag-search the stale-member
# scrub below already relies on.
find_live_peer() {
  local ip
  for ip in $(aws ec2 describe-instances --region "$REGION" \
      --filters "Name=tag:ClusterName,Values=$CLUSTER" "Name=tag:Role,Values=etcfs-node" \
                "Name=instance-state-name,Values=running,pending" \
      --query 'Reservations[].Instances[].PrivateIpAddress' --output text 2>/dev/null \
      | tr '\t' '\n' | grep -v "^$PRIV_IP$" || true); do
    curl -sf -m 3 "http://$ip:2379/health" >/dev/null 2>&1 && { echo "$ip"; return 0; }
  done
  return 1
}

CLUSTER_STATE=""
for attempt in $(seq 1 20); do
  if put_if_absent; then
    log "won cluster-formation election (attempt $attempt) — forming a new etcd cluster"
    INITIAL_CLUSTER="$NODE_ID=http://$PRIV_IP:2380"
    CLUSTER_STATE=new
    SEED="$PRIV_IP"
    break
  fi

  ITEM=$(aws dynamodb get-item --region "$REGION" --table-name "$TABLE" --consistent-read \
    --key "{\"cluster_name\":{\"S\":\"$CLUSTER\"}}" --output json 2>/dev/null)
  SEED=$(echo "$ITEM" | jq -r '.Item.seed_ip.S // empty')
  CREATED=$(echo "$ITEM" | jq -r '.Item.created_at.N // empty')
  if [[ -z "$SEED" || -z "$CREATED" ]]; then
    sleep 3
    continue
  fi
  log "joining existing cluster via seed $SEED (elected, attempt $attempt)"

  READY=0
  for _ in $(seq 1 20); do
    curl -sf -m 3 "http://$SEED:2379/health" >/dev/null 2>&1 && { READY=1; break; }
    sleep 3
  done
  if [[ "$READY" -eq 1 ]]; then
    CLUSTER_STATE=existing
    break
  fi

  AGE=$(( $(date +%s) - CREATED ))
  if [[ "$AGE" -lt "$STALE_SECONDS" ]]; then
    log "seed $SEED not answering yet, age $AGE sec, below the $STALE_SECONDS sec staleness bar — retrying, not reclaiming"
    sleep "$(( (RANDOM % 5) + 3 ))"
    continue
  fi

  # Only now, with the recorded seed both unreachable and past the staleness
  # bar, is it worth the API calls to ask whether *any* member survives.  A
  # peer answering /health means the cluster is alive and the row is merely
  # out of date: join through that peer and repoint the row at it, so the
  # next joiner gets a live hint instead of repeating this detour.  The
  # repoint is best-effort — losing its CAS to another node doing the same
  # thing is a correct outcome, not a failure.
  if LIVE_PEER=$(find_live_peer); then
    log "seed $SEED unreachable but peer $LIVE_PEER is serving — joining through it, not reclaiming"
    repoint_if_unchanged "$LIVE_PEER" "$SEED" "$CREATED" \
      && log "seed row repointed to $LIVE_PEER" \
      || log "seed row repoint lost its CAS (another node got there first) — harmless, continuing"
    SEED="$LIVE_PEER"
    CLUSTER_STATE=existing
    break
  fi

  log "seed $SEED unreachable, $AGE sec old, and no peer is serving — attempting conditional reclaim"
  if repoint_if_unchanged "$PRIV_IP" "$SEED" "$CREATED"; then
    log "won reclaim — forming a new etcd cluster"
    INITIAL_CLUSTER="$NODE_ID=http://$PRIV_IP:2380"
    CLUSTER_STATE=new
    SEED="$PRIV_IP"
    break
  fi
  # Someone else's reclaim (or a fresh create) won the conditional write —
  # loop back and read whatever is there now instead of assuming failure.
done
[[ -n "$CLUSTER_STATE" ]] || { log "FATAL: could not elect a seed or join a cluster after 20 attempts"; exit 1; }

if [[ "$CLUSTER_STATE" == "existing" ]]; then
  # A crashed node (killed outright, not a graceful ASG scale-in) never runs
  # the graceful-leave Lambda's `member remove` — it just stops responding,
  # still listed as a voting member. etcd's own runbook is explicit that a
  # dead member must be removed *before* a replacement is added: an add
  # while a dead voter is still registered raises the quorum requirement
  # (3-of-4) before the new member is up to help meet it, so the config
  # change itself can wedge. Reproduced this for real by hard-killing a
  # node with ec2:TerminateInstances (bypassing the ASG lifecycle hook) and
  # watching the replacement's member add fail. Every joiner clears any
  # member whose peer IP has no matching running/pending EC2 instance
  # before adding itself — safe to run redundantly, since etcd just errors
  # (ignored) on a member ID that's already gone.
  mapfile -t LIVE_IPS < <(aws ec2 describe-instances --region "$REGION" \
    --filters "Name=tag:ClusterName,Values=$CLUSTER" "Name=tag:Role,Values=etcfs-node" \
              "Name=instance-state-name,Values=running,pending" \
    --query 'Reservations[].Instances[].PrivateIpAddress' --output text | tr '\t' '\n')
  while read -r MID MURL; do
    [[ -n "$MID" ]] || continue
    MIP=$(echo "$MURL" | sed -E 's#https?://([0-9.]+):.*#\1#')
    printf '%s\n' "$${LIVE_IPS[@]}" | grep -qx "$MIP" || {
      log "member $MID ($MIP) has no matching live instance — removing before joining"
      etcdctl --endpoints="http://$SEED:2379" member remove "$MID" 2>/dev/null || true
    }
  done < <(etcdctl --endpoints="http://$SEED:2379" member list -w simple 2>/dev/null | awk -F', ' '{print $1, $4}')

  INITIAL_CLUSTER=""
  for _ in $(seq 1 15); do
    ADDOUT=$(etcdctl --endpoints="http://$SEED:2379" member add "$NODE_ID" --peer-urls="http://$PRIV_IP:2380" 2>&1) && break
    if echo "$ADDOUT" | grep -q "Peer URLs already exists"; then
      break
    fi
    sleep 3
  done
  INITIAL_CLUSTER=$(echo "$ADDOUT" | grep '^ETCD_INITIAL_CLUSTER=' | cut -d= -f2- | tr -d '"')
  if [[ -z "$INITIAL_CLUSTER" ]]; then
    INITIAL_CLUSTER=$(etcdctl --endpoints="http://$SEED:2379" member list -w simple 2>/dev/null \
      | awk -F', ' '{print $3"="$4}' | paste -sd, -)
  fi
  [[ -n "$INITIAL_CLUSTER" ]] || { log "FATAL: could not join etcd cluster via $SEED"; exit 1; }
fi

# ---- Endpoints for the EtcFS daemons: tag-discovered peers plus self,
# independent of which one formed or joined the etcd cluster above ----
mapfile -t PEERS < <(aws ec2 describe-instances --region "$REGION" \
  --filters "Name=tag:ClusterName,Values=$CLUSTER" "Name=tag:Role,Values=etcfs-node" \
            "Name=instance-state-name,Values=running,pending" \
  --query 'Reservations[].Instances[].PrivateIpAddress' --output text | tr '\t' '\n' | grep -v "^$PRIV_IP$" || true)
ENDPOINTS="http://$PRIV_IP:2379"
for p in "$${PEERS[@]}"; do ENDPOINTS+=",http://$p:2379"; done

# ---- etcd ----
cat >/etc/systemd/system/etcd.service <<UNIT
[Unit]
Description=etcd (EtcFS metadata store)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/etcd --name $NODE_ID --data-dir /var/lib/etcd \\
  --wal-dir $ETCD_WAL_DIR \\
  --listen-client-urls http://0.0.0.0:2379 --advertise-client-urls http://$PRIV_IP:2379 \\
  --listen-peer-urls http://0.0.0.0:2380 --initial-advertise-peer-urls http://$PRIV_IP:2380 \\
  --initial-cluster "$INITIAL_CLUSTER" --initial-cluster-state $CLUSTER_STATE \\
  --auto-compaction-mode revision --auto-compaction-retention 100000 \\
  --quota-backend-bytes 8589934592
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now etcd

# ---- EtcFS daemons.
#
# Everything the whole cluster shares goes in etcfuse-meta's config file, so
# the ExecStart the package ships is used as-is and a package upgrade cannot
# silently drop a setting the way editing it in place would. What is left in
# a drop-in is only what genuinely differs per node — this instance's own
# identity, which no shared file could carry.
#
# Note the split is forced, not stylistic: a flag beats the file, so anything
# named here overrides the same key below without saying so. ----
mkdir -p /etc/etcfs
cat >/etc/etcfs/etcfuse-meta.yaml <<CONF
etcd-endpoints: $ENDPOINTS
cluster-name: $CLUSTER
lease-ttl: $LEASE_TTL
block-device: $DEVICE
ebs-volume-id: $VOLUME_ID
log-level: 1
CONF

mkdir -p /etc/systemd/system/etcfuse-meta.service.d
cat >/etc/systemd/system/etcfuse-meta.service.d/override.conf <<UNIT
[Service]
ExecStart=
ExecStart=/usr/local/bin/etcfuse-meta --node-id=$NODE_ID --ec2-instance-id=$INSTANCE_ID
UNIT

# etcfuse itself is built from source above (glibc mismatch workaround), so
# there is no package unit to drop an override onto — write the unit whole,
# matching deploy/systemd/etcfuse.service's shape.
cat >/etc/systemd/system/etcfuse.service <<UNIT
[Unit]
Description=EtcFS FUSE Daemon
After=network-online.target etcfuse-meta.service
Wants=network-online.target etcfuse-meta.service

[Service]
Type=simple
ExecStart=/usr/local/bin/etcfuse --socket=/run/etcfuse/etcfuse.sock --node-id=$NODE_ID --log-level=1 /mnt/etcfuse
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now etcfuse-meta
sleep 4
systemctl enable --now etcfuse

for _ in $(seq 1 20); do
  mountpoint -q /mnt/etcfuse && break
  sleep 1
done
mountpoint -q /mnt/etcfuse || { log "FATAL: EtcFS never mounted"; journalctl -u etcfuse -u etcfuse-meta --no-pager | tail -60; exit 1; }

log "node $NODE_ID up and mounted"
